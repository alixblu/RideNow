# RideNow - environment template for the whole-system stack (docker-compose.yml).
#
# Copy this file to `.env` and adjust as needed:
#     cp .env.example .env
#
# `.env` is gitignored; this `.env.example` is the committed, secret-free
# template. These variable NAMES map 1:1 to the keys you will later put in a
# Kubernetes ConfigMap/Secret or AWS Secrets Manager. The local values here are
# development-only placeholders, never used in the cloud.
#
# NOTE: the app containers build datasource URLs from the DB_* values below
# (see docker-compose.yml). When you point a service at Amazon RDS instead, you
# only change SPRING_DATASOURCE_* for that service's container - same image.

# ---- user-service database ----
USER_DB_NAME=user_service
USER_DB_USERNAME=app_user
USER_DB_PASSWORD=user_local

# ---- driver-service database ----
DRIVER_DB_NAME=driver_service
DRIVER_DB_USERNAME=driver
DRIVER_DB_PASSWORD=driver_local

# ---- trip-service database ----
TRIP_DB_NAME=trip_service
TRIP_DB_USERNAME=trip
TRIP_DB_PASSWORD=trip_local

# ---- payment-service database ----
PAYMENT_DB_NAME=payment_service
PAYMENT_DB_USERNAME=payment
PAYMENT_DB_PASSWORD=payment_local

# ---- notification-worker database ----
NOTIFICATION_DB_NAME=notification_service
NOTIFICATION_DB_USERNAME=notification
NOTIFICATION_DB_PASSWORD=notification_local

# ---- matching-service database ----
MATCHING_DB_NAME=matching_service
MATCHING_DB_USERNAME=matching
MATCHING_DB_PASSWORD=matching_local

# ---- Async messaging (LocalStack: SQS + EventBridge) ----
# Local stand-in for AWS. These NAMES map to the real AWS resources later
# (iac/stacks/05-messaging.yaml). The services reach LocalStack via AWS_ENDPOINT;
# in real AWS you drop AWS_ENDPOINT and supply real credentials/region instead.
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
EVENTS_BUS_NAME=ridenow-local-events

# ---- Redis (local stand-in for Amazon ElastiCache) ----
# Live driver location/availability (primary store, NOT in Postgres), the GEO
# index matching-service queries, the live-tracking pub/sub channel, and an
# optional cache-aside store. In the cloud these point at an ElastiCache endpoint.
REDIS_HOST=redis
REDIS_PORT=6379
