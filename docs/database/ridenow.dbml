// ============================================================
// RideNow - Core Database Schema
// ============================================================
//
// This DBML describes the logical system-wide data model.
//
// IMPORTANT MICROSERVICE RULE:
// Each service owns its own database/schema.
//
// References between different services are LOGICAL relationships.
// They must NOT become cross-service database foreign keys or
// JPA relationships.
//
// Live driver location / availability is intentionally NOT stored
// here. That state will later live in Redis.
//
// Docs: https://dbml.dbdiagram.io/docs
// ============================================================


// ============================================================
// USER SERVICE
// ============================================================

Table users {
  id uuid [primary key]

  // External authentication identity.
  // Keep this if AWS Cognito is the chosen identity provider.
  cognito_sub varchar [unique, not null]

  email varchar [unique, not null]
  phone varchar [unique]

  full_name varchar [not null]
  avatar_url varchar

  status varchar [not null, default: 'ACTIVE', note: '''
    ACTIVE,
    SUSPENDED
  ''']

  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    email [unique]
    phone [unique]
  }
}


// ============================================================
// DRIVER SERVICE
// ============================================================

Table drivers {
  id uuid [primary key]

  // Logical reference to User Service.
  user_id uuid [unique, not null]

  license_number varchar [unique, not null]

  status varchar [not null, default: 'ACTIVE', note: '''
    ACTIVE,
    SUSPENDED
  ''']

  // Denormalized summary values for fast profile/history display.
  average_rating decimal(3,2)
  total_trips bigint [not null, default: 0]

  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    user_id [unique]
    license_number [unique]
  }
}


Table vehicles {
  id uuid [primary key]

  driver_id uuid [not null]

  plate_number varchar [unique, not null]

  vehicle_type varchar [not null, note: '''
    MOTORBIKE,
    CAR
  ''']

  brand varchar
  model varchar
  color varchar

  active boolean [not null, default: true]

  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    driver_id
    plate_number [unique]
  }
}


// ============================================================
// TRIP SERVICE
// ============================================================

Table trips {
  id uuid [primary key]

  // Cross-service references are stored as IDs only.
  passenger_id uuid [not null]
  driver_id uuid
  vehicle_id uuid

  ride_type varchar [not null, note: '''
    MOTORBIKE,
    CAR
  ''']

  pickup_lat decimal(9,6) [not null]
  pickup_lng decimal(9,6) [not null]
  pickup_address varchar

  destination_lat decimal(9,6) [not null]
  destination_lng decimal(9,6) [not null]
  destination_address varchar

  status varchar [not null, default: 'REQUESTED', note: '''
    REQUESTED,
    SEARCHING,
    DRIVER_ASSIGNED,
    DRIVER_ARRIVED,
    IN_PROGRESS,
    COMPLETED,
    CANCELLED
  ''']

  estimated_fare decimal(12,2)
  final_fare decimal(12,2)

  cancellation_reason varchar

  // Used by JPA @Version for optimistic concurrency control.
  version bigint [not null, default: 0]

  requested_at timestamp [not null]
  accepted_at timestamp
  arrived_at timestamp
  started_at timestamp
  completed_at timestamp
  cancelled_at timestamp

  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    passenger_id
    driver_id
    status
    requested_at
    (passenger_id, requested_at)
    (driver_id, requested_at)
  }
}


// Records which drivers were offered a particular trip.
//
// This is useful for:
// - matching history
// - accept/decline tracking
// - offer expiration
// - concurrent ride acceptance experiments
Table trip_offers {
  id uuid [primary key]

  trip_id uuid [not null]

  // Logical reference to Driver Service.
  driver_id uuid [not null]

  status varchar [not null, default: 'PENDING', note: '''
    PENDING,
    ACCEPTED,
    DECLINED,
    EXPIRED
  ''']

  // Distance when this candidate was selected.
  distance_meters integer

  offered_at timestamp [not null]
  responded_at timestamp
  expires_at timestamp

  indexes {
    (trip_id, driver_id) [unique]
    trip_id
    driver_id
    status
    expires_at
  }
}


// ============================================================
// PAYMENT SERVICE
// ============================================================

Table payments {
  id uuid [primary key]

  // Logical reference to Trip Service.
  // One payment record per trip for the initial project scope.
  trip_id uuid [unique, not null]

  amount decimal(12,2) [not null]

  currency varchar(3) [not null, default: 'VND']

  method varchar [not null, note: '''
    CASH,
    SIMULATED_CARD,
    PAYPAL
  ''']

  status varchar [not null, default: 'PENDING', note: '''
    PENDING,
    PROCESSING,
    PAID,
    FAILED
  ''']

  // Allows retries without creating duplicate payment effects.
  idempotency_key varchar [unique, not null]

  failure_reason varchar

  created_at timestamp [not null]
  updated_at timestamp [not null]
  paid_at timestamp
  failed_at timestamp

  indexes {
    trip_id [unique]
    idempotency_key [unique]
    status
  }
}


// ============================================================
// RATING
// ============================================================
//
// For the initial scope this is shown as its own logical domain.
// Service ownership can be decided when the rating feature is built.
//
Table ratings {
  id uuid [primary key]

  // Logical reference to Trip Service.
  trip_id uuid [not null]

  // Logical references to User Service.
  reviewer_user_id uuid [not null]
  target_user_id uuid [not null]

  rating_type varchar [not null, note: '''
    PASSENGER_TO_DRIVER,
    DRIVER_TO_PASSENGER
  ''']

  score smallint [not null, note: 'Valid range: 1-5']
  comment text

  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (trip_id, reviewer_user_id) [unique]
    target_user_id
    rating_type
  }
}


// ============================================================
// LOGICAL RELATIONSHIPS
// ============================================================
//
// IMPORTANT:
// These relationships document the overall domain model.
//
// In the microservice implementation, relationships crossing service
// boundaries must NOT become physical foreign keys or JPA entity
// relationships.
//
// Example:
// trips.passenger_id is UUID passengerId,
// NOT @ManyToOne User passenger.
//
// ============================================================


// User -> Driver
Ref: drivers.user_id > users.id


// Driver -> Vehicles
Ref: vehicles.driver_id > drivers.id


// Passenger -> Trips
Ref: trips.passenger_id > users.id


// Assigned Driver -> Trips
Ref: trips.driver_id > drivers.id


// Vehicle used for Trip
Ref: trips.vehicle_id > vehicles.id


// Trip -> Offers
Ref: trip_offers.trip_id > trips.id


// Driver -> Offers
Ref: trip_offers.driver_id > drivers.id


// Trip -> Payment
Ref: payments.trip_id - trips.id


// Trip -> Ratings
Ref: ratings.trip_id > trips.id


// Rating author
Ref: ratings.reviewer_user_id > users.id


// User being rated
Ref: ratings.target_user_id > users.id