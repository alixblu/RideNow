# RideNow Frontend configuration (copy to `.env` for local overrides).
#
# All runtime config is read from Vite env vars prefixed with VITE_.
# `.env` is gitignored; this file documents the available settings.

# --- Backend origin ---------------------------------------------------------
# Single gateway-style base URL. When set, every backend request is sent to this
# origin with the documented path prefix preserved (Req 3.1, 3.2).
# Leave blank/unset to use the local Path_Prefix_Map fallback that routes each
# path prefix to its individual service origin (Req 3.3):
#   /api/drivers, /api/vehicles  -> driver-service  (http://localhost:8080)
#   /api/users                   -> user-service    (http://localhost:8081)
#   /api/trips, /api/trip-offers -> trip-service     (http://localhost:8082)
#   /api/payments                -> payment-service  (http://localhost:8083)
#   /api/notifications           -> notification-worker (http://localhost:8084)
#   /live                        -> realtime-gateway   (http://localhost:8086, SSE)
#   /api/matching                -> matching-service (internal; no public route)
# In a browser against the local stack, use the Vite dev proxy (the services send no
# CORS headers): VITE_API_BASE_URL=http://localhost:5173
# Deployed example (Gateway URL): VITE_API_BASE_URL=https://api.ridenow.example.com
VITE_API_BASE_URL=

# Dev proxy target (dev server only). When set, the Vite proxy forwards every
# backend path (/api/*, /live) to this origin instead of the local services, so a
# browser on :5173 can use a deployed stack without CORS. Use together with
# VITE_API_BASE_URL=http://localhost:5173. Example: the prod ALB URL.
VITE_PROXY_TARGET=

# --- Per-domain client mode (live | mock) -----------------------------------
# Selects the Live_Client (real HTTP) or Mock_Client (in-memory) per domain.
# Domains backed by a running service default to `live`; the rest default to `mock`.

# LIVE domains (backed by implemented endpoints)
VITE_CLIENT_DRIVER=live
VITE_CLIENT_VEHICLE=live
VITE_CLIENT_USER=live
VITE_CLIENT_TRIP=live
VITE_CLIENT_PAYMENT=live

VITE_CLIENT_NOTIFICATION=live
# STUBBED domain — matching-service has no public route, so it stays mock-only.
VITE_CLIENT_MATCHING=mock

# --- Road snapping (OSRM) ---------------------------------------------------
# Display-only snapping of GPS points to roads, and the driver's simulated route.
# Empty = off: raw points, and the simulation drives a straight line.
# The public demo server (https://router.project-osrm.org) is for development only;
# check its usage policy. See docs/REALTIME.md section 7.
VITE_OSRM_URL=

# --- Address search (geocoding) ---------------------------------------------
# Nominatim-compatible geocoder used by the booking address fields (search and
# reverse lookup). Blank = address search is not configured.
# The public server is rate limited (max 1 request/second) and meant for development.
VITE_GEOCODER_URL=https://nominatim.openstreetmap.org

# --- Driver movement simulation ---------------------------------------------
# Simulated driver speed in km/h. Must be a positive number; invalid or blank
# values fall back to 30.
VITE_SIM_SPEED_KMH=30