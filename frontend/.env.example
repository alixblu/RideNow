# RideNow Frontend configuration (copy to `.env` for local overrides).
#
# All runtime config is read from Vite env vars prefixed with VITE_.
# `.env` is gitignored; this file documents the available settings.

# --- Backend origin ---------------------------------------------------------
# Single gateway-style base URL. When set, every backend request is sent to this
# origin with the documented path prefix preserved (Req 3.1, 3.2).
# Leave blank/unset to use the local Path_Prefix_Map fallback that routes each
# path prefix to its individual service origin (Req 3.3):
#   /api/drivers, /api/vehicles -> driver-service (http://localhost:8080)
#   /api/users                  -> user-service   (http://localhost:8081)
VITE_API_BASE_URL=

# --- Per-domain client mode (live | mock) -----------------------------------
# Selects the Live_Client (real HTTP) or Mock_Client (in-memory) per domain.
# LIVE domains default to `live`; STUBBED domains default to `mock`.

# LIVE domains (backed by implemented endpoints)
VITE_CLIENT_DRIVER=live
VITE_CLIENT_VEHICLE=live
VITE_CLIENT_USER=live

# STUBBED domains (mock-only today, behind a documented future contract)
VITE_CLIENT_TRIP=mock
VITE_CLIENT_MATCHING=mock
VITE_CLIENT_PAYMENT=mock
VITE_CLIENT_NOTIFICATION=mock
